# Glyvio development settings. Copy to .env (never commit .env).
# Web app address (used by browser tests, not by the type generator)
G_APP_URL=https://alpha.glyvio.com
# Authentication server
G_AUTH_URL=https://auth-webapi-prod.glyvio.com/
# Company used to resolve the plugin versions and generate the types
G_COMPANY_ID=
# Your Glyvio login and password
G_USERNAME=
G_PASSWORD=
# Optional: API address for the type generator (default https://webapi-prod.glyvio.com)
# G_API_URL=
